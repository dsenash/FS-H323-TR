STATE=/var/lib/mod-aa-h323-tr
case "$1" in
remove|purge)
    if [ -f "$STATE/install.env" ]; then
        . "$STATE/install.env"
        if [ -n "${FS_CLI:-}" ] && [ -x "$FS_CLI" ]; then
            "$FS_CLI" -x "unload mod_aa_h323_tr" >/dev/null 2>&1 || true
        fi
    fi
    ;;
esac
exit 0
